# Copy to backend/.env and fill in. Every value has a safe local default.

# --- Default AI engine: auto (first configured free engine) | gemini | groq | ollama | anthropic | openai | mock ---
# Every engine that is set up below can also be picked per job in the app.
LLM_PROVIDER=auto

# Free cloud AI for every customer (free tiers have daily / per-minute limits)
# Gemini: https://aistudio.google.com -> Get API key   |   Groq: https://console.groq.com -> API Keys
GEMINI_API_KEY=
# Flash-Lite has a much higher free daily allowance than Flash (~20 requests/day). See https://ai.dev/rate-limit
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude only for organizations that add their own key in Settings (billed to them).
# false = paid plans may also use the platform ANTHROPIC_API_KEY below.
CLAUDE_OWN_KEY_ONLY=true

# Free local AI: install https://ollama.com, then run: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Claude (cloud, paid per use): key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (higher = better reasoning, more tokens)
ANTHROPIC_EFFORT=medium
# Retry a declined request on a fallback model automatically
ANTHROPIC_FALLBACKS=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# --- Security: use a long random string in production ---
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# --- Database (SQLite by default; PostgreSQL in Docker/production) ---
# DATABASE_URL=postgresql+psycopg://catalogai:catalogai@localhost:5432/catalogai

# --- Background jobs: thread (local) | celery (production, needs Redis) ---
TASK_MODE=thread
REDIS_URL=redis://localhost:6379/0
GENERATION_CONCURRENCY=4

# --- File storage: local | s3 ---
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=us-east-1

# --- Public URL of the web app (used in email links) ---
APP_URL=http://localhost:5173

# --- Platform owner(s): comma-separated emails that get the "Platform admin" panel ---
SUPERADMIN_EMAILS=

# --- Encryption of stored secrets. Optional: derived from SECRET_KEY when empty.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it after secrets are stored (they would become unreadable).
ENCRYPTION_KEY=

# --- Email: console (prints to the API log) | smtp ---
EMAIL_BACKEND=console
EMAIL_FROM=Inkventory <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Billing (optional): Lemon Squeezy checkout links + variant ids per plan ---
# Webhook URL to configure in Lemon Squeezy: https://<your-domain>/api/billing/webhook/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CHECKOUT_PRO=
LEMONSQUEEZY_CHECKOUT_BUSINESS=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_BUSINESS=
# Shown to customers who want to pay by bank transfer / invoice
BILLING_CONTACT=

# --- Sign in with Google / Microsoft (optional) ---
# Redirect URIs to register: {APP_URL}/api/auth/sso/google/callback and .../microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
SSO_ALLOW_SIGNUP=true

# --- Security ---
LOGIN_ATTEMPTS_PER_15_MIN=10

# --- Writing quality ---
# One automatic revision for drafts below this SEO score, or with invented numbers / wrong language.
AUTO_IMPROVE=true
AUTO_IMPROVE_MIN_SCORE=85
# Show the AI up to 2 descriptions your team approved (hand-edited first) as a style reference.
LEARN_FROM_APPROVED=true
